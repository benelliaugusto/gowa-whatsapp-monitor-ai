# ============================================================================
# monitor-ia — variáveis de ambiente (copie para .env ou cole no Easypanel)
# ============================================================================

# --- aplicação --------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
DATABASE_PATH=/data/monitor.db
LOG_LEVEL=INFO

# --- GOWA -------------------------------------------------------------------
# Em Easypanel, na mesma "project", o host interno segue <projeto>_<serviço>.
# Confirme no Shell do monitor-ia: getent hosts <projeto>_gowa-server
GOWA_URL=http://projeto_gowa-server:3000
# Mesmo valor do APP_BASIC_AUTH do GOWA (formato usuario:senha)
GOWA_BASIC_AUTH=admin:troque-esta-senha
# Opcional: slot fixo do GOWA (vazio = descobre sozinho em GET /devices)
GOWA_DEVICE_ID=
# Mesmo valor do WHATSAPP_WEBHOOK_SECRET do GOWA (habilita validação HMAC)
GOWA_WEBHOOK_SECRET=
# Alternativa simples ao HMAC: exige ?token=... na URL do webhook
GOWA_WEBHOOK_TOKEN=

# --- sincronização automática ----------------------------------------------
SYNC_ENABLED=true
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=15
SYNC_WINDOW_DAYS=3
SYNC_PAGE_SIZE=100
SYNC_MAX_PAGES=6
SYNC_MAX_CHATS=300
SYNC_INCLUDE_GROUPS=false

# --- API para os agentes de IA ---------------------------------------------
# formato: nome:escopo:chave, onde escopo = rw (leitura+escrita) ou ro (leitura)
API_KEYS=claude:rw:troque-esta-chave-1,grok:ro:troque-esta-chave-2
REQUIRE_API_KEY=true

# --- painel do gestor -------------------------------------------------------
DASHBOARD_USER=gestor
DASHBOARD_PASSWORD=troque-esta-senha-forte

# --- digest -----------------------------------------------------------------
DIGEST_MAX_CHARS=60000
# --- transcrição local de áudios (faster-whisper) ---------------------------
TRANSCRIBE_ENABLED=true
WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=/data/models # fica no volume: não baixa a cada deploy
WHISPER_LANGUAGE=pt
WHISPER_INTERVAL_SECONDS=60

# --- horário comercial (métricas e alertas) --------------------------------
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=1,2,3,4,5        # 0=domingo ... 6=sábado

# --- avisos ao gestor pelo WhatsApp ---------------------------------------
MANAGER_WHATSAPP=5511999999999 # só dígitos com DDI
MANAGER_NAME=Gestor

# --- backup ----------------------------------------------------------------
BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# --- agente em cron (python -m app.agent) ----------------------------------
LLM_PROVIDER=anthropic         # anthropic | openai | opencode
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=                  # ex.: https://api.x.ai/v1
# OpenCode Go/Console:
# LLM_PROVIDER=opencode
# LLM_MODEL=deepseek-v4.1-flash
# LLM_BASE_URL=https://opencode.ai/inference/go   (pay-as-you-go: /inference)
# o agente em cron é outro container: use o host interno do serviço monitor-ia
MONITOR_API_URL=http://projeto_monitor-ia:8000
MONITOR_API_KEY=               # chave rw do próprio monitor (para o cron)