# ============================================================================
# monitor-ia — variáveis de ambiente (copie para .env ou cole no Easypanel)
# ============================================================================

# --- aplicação --------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
DATABASE_PATH=/data/monitor.db
LOG_LEVEL=INFO

# --- GOWA -------------------------------------------------------------------
# Em Easypanel, na mesma "project", o host interno segue <projeto>_<serviço>.
# Confirme no Shell do monitor-ia: getent hosts <projeto>_gowa-server
GOWA_URL=http://projeto_gowa-server:3000
# Mesmo valor do APP_BASIC_AUTH do GOWA (formato usuario:senha)
GOWA_BASIC_AUTH=admin:troque-esta-senha
# Opcional: slot fixo do GOWA (vazio = descobre sozinho em GET /devices)
GOWA_DEVICE_ID=
# Mesmo valor do WHATSAPP_WEBHOOK_SECRET do GOWA (habilita validação HMAC)
GOWA_WEBHOOK_SECRET=
# Alternativa simples ao HMAC: exige ?token=... na URL do webhook
GOWA_WEBHOOK_TOKEN=

# --- sincronização automática ----------------------------------------------
SYNC_ENABLED=true
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=15
SYNC_WINDOW_DAYS=3
SYNC_PAGE_SIZE=100
SYNC_MAX_PAGES=6
SYNC_MAX_CHATS=300
SYNC_INCLUDE_GROUPS=false

# --- API para os agentes de IA ---------------------------------------------
# formato: nome:escopo:chave, onde escopo = rw (leitura+escrita) ou ro (leitura)
API_KEYS=claude:rw:troque-esta-chave-1,grok:ro:troque-esta-chave-2
REQUIRE_API_KEY=true

# --- painel do gestor -------------------------------------------------------
DASHBOARD_USER=gestor
DASHBOARD_PASSWORD=troque-esta-senha-forte

# --- digest -----------------------------------------------------------------
DIGEST_MAX_CHARS=60000